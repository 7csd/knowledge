ity_warnings": [], "source_locations": [{"file_id": "D01-canonical", "source_path": "data/source_materials/corpus/pdf_native/D01_费用报销制度甲_原生.pdf", "sha256": "e44b5b4ce13137c381e6910f5304e7b8a583e6dd84756e9c49fdf5520fcd7933", "method": "pdf_text", "page": 1, "bbox": [48.0, 600.1171875, 191.75, 611.6171875], "line_start": null, "line_end": null, "confidence": null}, {"file_id": "D01-canonical", "source_path": "data/source_materials/corpus/pdf_native/D01_费用报销制度甲_原生.pdf", "sha256": "e44b5b4ce13137c381e6910f5304e7b8a583e6dd84756e9c49fdf5520fcd7933", "method": "pdf_text", "page": 1, "bbox": [48.0, 626.9765625, 541.5, 672.4765625], "line_start": null, "line_end": null, "confidence": null}], "snippet": "第四条 不同材料之间的关系\n\n费用报销提交期限、费用金额标准和支付处理时间属于不同事项。住宿限额应查阅住宿制度，不能用本制度的提交期限推算住宿额度；本文也不规定年假、工资、社保或税务处理方法。资料没有给出的事项，应补充相应制度再确认。", "rrf_score": 0.015873, "bm25_score": 6.513884, "vector_score": null}, {"doc_id": "D09", "version_date": "2026-01-01", "chunk_id": "c001", "title": "密码规则新版", "topic": "密码规则", "scope": "企业账号", "status": "有效", "parent_id": "r001", "related_ids": [], "heading_path": ["密码规则新版", "正文"], "token_count": 71, "kind": "text", "table_id": null, "row_id": null, "quality_warnings": [], "source_locations": [{"file_id": "D09-canonical", "source_path": "data/source_materials/corpus/markdown/D09_密码规则新版.md", "sha256": "71ad9ff23c2dcf6e540cf1d673187f2bb0977564ec21c1a7fd9402e6c00951e4", "method": "markdown", "page": null, "bbox": null, "line_start": 13, "line_end": 13, "confidence": null}], "snippet": "自2026年1月1日起，企业账号密码至少12位，每90天更换一次。本制度明确替代2025年1月1日发布的D08密码规则。", "rrf_score": 0.015625, "bm25_score": 4.939976, "vector_score": null}, {"doc_id": "D08", "version_date": "2025-01-01", "chunk_id": "c001", "title": "密码规则旧版", "topic": "密码规则", "scope": "企业账号", "status": "历史", "parent_id": "r001", "related_ids": [], "heading_path": ["密码规则旧版", "正文"], "token_count": 56, "kind": "text", "table_id": null, "row_id": null, "quality_warnings": [], "source_locations": [{"file_id": "D08-canonical", "source_path": "data/source_materials/corpus/markdown/D08_密码规则旧版.md", "sha256": "d784932c7532eb19b02039e65134b6fc557ec5352ea8d76ea639c0d4116576f3", "method": "markdown", "page": null, "bbox": null, "line_start": 13, "line_end": 13, "confidence": null}], "snippet": "企业账号密码至少8位，每180天更换一次。本版本自2026年1月1日起被D09替代。", "rrf_score": 0.015385, "bm25_score": 4.039124, "vector_score": null}, {"doc_id": "D04", "version_date": "2026-02-01", "chunk_id": "c043", "title": "出差住宿规则", "topic": "住宿", "scope": "国内出差", "status": "有效", "parent_id": "r043", "related_ids": [], "heading_path": ["出差住宿规则", "第六条 订单变化与退款"], "token_count": 228, "kind": "text", "table_id": null, "row_id": null, "quality_warnings": [], "source_locations": [{"file_id": "D04-canonical", "source_path": "data/source_materials/corpus/pdf_native/D04_出差住宿规则_跨页表格.pdf", "sha256": "c9384bbeeca21f469c6efc510eee893d76d2fff002f0e681c5bfeeb28a2a97d6", "method": "pdf_text", "page": 6, "bbox": [48.0, 323.1171875, 168.75, 334.6171875], "line_start": null, "line_end": null, "confidence": null}, {"file_id": "D04-canonical", "source_path": "data/source_materials/corpus/pdf_native/D04_出差住宿规则_跨页表格.pdf", "sha256": "c9384bbeeca21f469c6efc510eee893d76d2fff002f0e681c5bfeeb28a2a97d6", "method": "pdf_text", "page": 6, "bbox": [48.0, 349.9765625, 541.5, 377.9765625], "line_start": null, "line_end": null, "confidence": null}, {"file_id": "D04-canonical", "source_path": "data/source_materials/corpus/pdf_native/D04_出差住宿规则_跨页表格.pdf", "sha256": "c9384bbeeca21f469c6efc510eee893d76d2fff002f0e681c5bfeeb28a2a97d6", "method": "pdf_text", "page": 6, "bbox": [48.0, 393.9765625, 541.5, 439.4765625], "line_start": null, "line_end": null, "confidence": null}], "snippet": "第六条 订单变化与退款\n\n行程变更导致取消、改期、提前离店或延住时，应保留原订单与变更记录，说明实际入住情况及退款金额。退款后不得按原订单全额报销；产生取消费时，应说明原因并请求确认，本文不规定取消费自动可报。\n\n个人旅游延住不能在申请中隐去，业务住宿与个人住宿应分别说明。同行人员分别付款或一人代付时，应保留参与关系及分摊说明，防止同一晚住宿重复申报。本文未", "rrf_score": 0.015152, "bm25_score": 3.575413, "vector_score": null}]}}
