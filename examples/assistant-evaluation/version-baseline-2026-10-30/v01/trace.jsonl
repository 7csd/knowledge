/D04_出差住宿规则_跨页表格.pdf", "sha256": "c9384bbeeca21f469c6efc510eee893d76d2fff002f0e681c5bfeeb28a2a97d6", "method": "pdf_text", "page": 6, "bbox": [48.0, 349.9765625, 541.5, 377.9765625], "line_start": null, "line_end": null, "confidence": null}, {"file_id": "D04-canonical", "source_path": "data/source_materials/corpus/pdf_native/D04_出差住宿规则_跨页表格.pdf", "sha256": "c9384bbeeca21f469c6efc510eee893d76d2fff002f0e681c5bfeeb28a2a97d6", "method": "pdf_text", "page": 6, "bbox": [48.0, 393.9765625, 541.5, 439.4765625], "line_start": null, "line_end": null, "confidence": null}], "snippet": "第六条 订单变化与退款\n\n行程变更导致取消、改期、提前离店或延住时，应保留原订单与变更记录，说明实际入住情况及退款金额。退款后不得按原订单全额报销；产生取消费时，应说明原因并请求确认，本文不规定取消费自动可报。\n\n个人旅游延住不能在申请中隐去，业务住宿与个人住宿应分别说明。同行人员分别付款或一人代付时，应保留参与关系及分摊说明，防止同一晚住宿重复申报。本文未", "rrf_score": 0.015873, "bm25_score": 2.824761, "vector_score": 0.390034}, {"doc_id": "D01", "version_date": "2026-01-01", "chunk_id": "c013", "title": "费用报销制度甲", "topic": "报销期限", "scope": "未说明", "status": "未说明", "parent_id": "r013", "related_ids": [], "heading_path": ["费用报销制度甲", "第十三条 代付与分摊示例"], "token_count": 222, "kind": "text", "table_id": null, "row_id": null, "quality_warnings": [], "source_locations": [{"file_id": "D01-canonical", "source_path": "data/source_materials/corpus/pdf_native/D01_费用报销制度甲_原生.pdf", "sha256": "e44b5b4ce13137c381e6910f5304e7b8a583e6dd84756e9c49fdf5520fcd7933", "method": "pdf_text", "page": 4, "bbox": [48.0, 184.6171875, 180.25, 196.1171875], "line_start": null, "line_end": null, "confidence": null}, {"file_id": "D01-canonical", "source_path": "data/source_materials/corpus/pdf_native/D01_费用报销制度甲_原生.pdf", "sha256": "e44b5b4ce13137c381e6910f5304e7b8a583e6dd84756e9c49fdf5520fcd7933", "method": "pdf_text", "page": 4, "bbox": [48.0, 211.4765625, 541.5, 256.9765625], "line_start": null, "line_end": null, "confidence": null}, {"file_id": "D01-canonical", "source_path": "data/source_materials/corpus/pdf_native/D01_费用报销制度甲_原生.pdf", "sha256": "e44b5b4ce13137c381e6910f5304e7b8a583e6dd84756e9c49fdf5520fcd7933", "method": "pdf_text", "page": 4, "bbox": [48.0, 272.9765625, 541.5, 300.9765625], "line_start": null, "line_end": null, "confidence": null}], "snippet": "第十三条 代付与分摊示例\n\n员工甲为同一项目的三名成员代付交通费用时，应在申请中列出同行人员、出行事项、实际支付金额和分摊说明。同行人员不应再次按相同凭据申报。若部分行程属于个人安排，应明确个人承担部分，不能将其隐藏在项目合计金额中。\n\n一个订单含两个项目的支出时，应说明分摊口径并由相应业务负责人确认。本文未规定必须按人数、时间或项目预算比例分摊，不能为了方", "rrf_score": 0.015625, "bm25_score": 2.288626, "vector_score": 0.355518}]}}
