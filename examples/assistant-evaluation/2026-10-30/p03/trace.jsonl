ce_path": "data/source_materials/corpus/pdf_native/D05_办公网络接入指南_原生.pdf", "sha256": "468dcdffde9e628d40f6b7a32db4b483af08f657c4a450b05524e31b616e15cf", "method": "pdf_text", "page": 1, "bbox": [48.0, 532.4765625, 541.5, 560.4765625], "line_start": null, "line_end": null, "confidence": null}], "snippet": "第三节 开通申请与审批\n\n在IT服务台提交企业VPN开通申请，填写企业账号、所属业务和访问原因。申请中可以写明需要访问的内部系统，但不要因此认为对应系统的角色会同步授予。服务台根据申请执行审核与开通，审批通过后方可按通知使用。\n\n申请提交、申请获批和实际开通是不同状态。尚未收到开通结果时，不应反复尝试其他人的账号。申请被退回时，应根据缺失项补充真实业务说明；", "rrf_score": 0.016129, "bm25_score": 7.617116, "vector_score": 0.309335}, {"doc_id": "D11", "version_date": "2026-01-05", "chunk_id": "c001", "title": "快递领取规范", "topic": "快递", "scope": "总部办公区", "status": "有效", "parent_id": "r001", "related_ids": [], "heading_path": ["快递领取规范", "正文"], "token_count": 59, "kind": "text", "table_id": null, "row_id": null, "quality_warnings": [], "source_locations": [{"file_id": "D11-canonical", "source_path": "data/source_materials/corpus/markdown/D11_快递领取规范.md", "sha256": "f05f6939113789ec6039b9b03044e9ed78fc7aa18617994111badee48dbba0e2", "method": "markdown", "page": null, "bbox": null, "line_start": 13, "line_end": 13, "confidence": null}], "snippet": "员工个人快递请在工作日18点前到一楼收发室领取，公司不承担个人快递的寄件费用。", "rrf_score": 0.015873, "bm25_score": 6.018287, "vector_score": 0.41128}, {"doc_id": "D11", "version_date": "2026-10-30", "chunk_id": "c001", "title": "快递领取规范", "topic": "快递", "scope": "总部办公区", "status": "有效", "parent_id": "r001", "related_ids": [], "heading_path": ["快递领取规范", "正文"], "token_count": 59, "kind": "text", "table_id": null, "row_id": null, "quality_warnings": [], "source_locations": [{"file_id": "D11-20261030", "source_path": "data/source_materials/corpus/markdown/D11_快递领取规范_20261030.md", "sha256": "3aa3c9ad4b3025933f90deb087bf1134efa4048e65e58c5ed80271a9d1aa9f6d", "method": "markdown", "page": null, "bbox": null, "line_start": 13, "line_end": 13, "confidence": null}], "snippet": "员工个人快递请在工作日17点前到一楼收发室领取，公司不承担个人快递的寄件费用。", "rrf_score": 0.015625, "bm25_sc