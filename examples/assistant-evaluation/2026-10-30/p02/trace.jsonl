_id": null, "row_id": null, "quality_warnings": [], "source_locations": [{"file_id": "D05-canonical", "source_path": "data/source_materials/corpus/pdf_native/D05_办公网络接入指南_原生.pdf", "sha256": "468dcdffde9e628d40f6b7a32db4b483af08f657c4a450b05524e31b616e15cf", "method": "pdf_text", "page": 5, "bbox": [48.0, 184.6171875, 180.25, 196.1171875], "line_start": null, "line_end": null, "confidence": null}, {"file_id": "D05-canonical", "source_path": "data/source_materials/corpus/pdf_native/D05_办公网络接入指南_原生.pdf", "sha256": "468dcdffde9e628d40f6b7a32db4b483af08f657c4a450b05524e31b616e15cf", "method": "pdf_text", "page": 5, "bbox": [48.0, 211.4765625, 541.5, 256.9765625], "line_start": null, "line_end": null, "confidence": null}, {"file_id": "D05-canonical", "source_path": "data/source_materials/corpus/pdf_native/D05_办公网络接入指南_原生.pdf", "sha256": "468dcdffde9e628d40f6b7a32db4b483af08f657c4a450b05524e31b616e15cf", "method": "pdf_text", "page": 5, "bbox": [48.0, 272.9765625, 541.5, 300.9765625], "line_start": null, "line_end": null, "confidence": null}], "snippet": "第十七节 开通与登录问答\n\n问：提交申请后能立即登录吗？答：需等待审批和实际开通，本文不承诺处理时长。问：审批通过后使用什么登录？答：企业账号和动态验证码。问：可以让同事把验证码发给我代登吗？答：不要向他人分享验证码，应使用本人账号。\n\n问：客户端显示已连接，为什么仍无法使用某项产品功能？答：连接成功不等于业务角色授权，应核对目标系统权限。问：能否在任意个人", "rrf_score": 0.029644, "bm25_score": 5.288837, "vector_score": 0.464275}, {"doc_id": "D05", "version_date": "2026-01-01", "chunk_id": "c015", "title": "办公网络接入指南", "topic": "VPN", "scope": "全体员工", "status": "有效", "parent_id": "r015", "related_ids": [], "heading_path": ["办公网络接入指南", "第十五节 可疑登录与凭据泄露"], "token_count": 233, "kind": "text", "table_id": null, "row_id": null, "quality_warnings": [], "source_locations": [{"file_id": "D05-canonical", "source_path": "data/source_materials/corpus/pdf_native/D05_办公网络接入指南_原生.pdf", "sha256": "468dcdffde9e628d40f6b7a32db4b483af08f657c4a450b05524e31b616e15cf", "method": "pdf_text", "page": 4, "bbox": [48.0, 479.1171875, 203.25, 490.6171875], "line_start": null, "line_end": null, "confidence": null}, {"file_id": "D05-canonical", "source_path": "data/source_materials/corpus/pdf_native/D05_办公网络接入指南_原生.pdf", "sha256": "468dcdffde9e628d40f6b7a32db4b483af08f657c4a450b05524e31b616e15cf", "method": "pdf_text", "page": 4, "bbox": [48.0, 505.9765625, 541.5, 533.9765625], "line_start": null, "line_end": null, "confidence": null}, {"file_id": "D05-canonical", "source_path": "data/source_materials/corpus/pdf_native/D05_办公网络接入指南_原生.pdf", "sha256": "468dcdffde9e628d40f6b7a32db4b483af08f657c4a450b05524e31b616e15cf", "method": "pdf_text", "page": 4, "bbox": [48.0, 549.9765625, 546.75, 577.9765625], "line_start": null, "line_end": null, "confidence": null}], "snippet": "第十五节 可疑登录与凭据泄露\n\n如果误把验证码发给他人、发现本人未发起的验证请求或看到异常登录提示，应停止相关操作并通过企业确认的渠道报告。不要继续向未知联系人提供新的验证码，也不要按陌生消息要求安装不明远程控制软件。\n\n本文仅给出报告原则，不规定账号冻结权限、密码重置步骤或安全事件分级。具体处置需查阅账号与安全事件制度。VPN连接成功不代表某条外部消息可信", "rrf_score": 0.02904, "bm25_score": 3.970014, "vector_score": 0.469775}, {"doc_id": "D05", "version_date": "2026-01-01", "chunk_id": "c018", "title": "办公网络接入指南", "topic": "VPN", "scope": "全体员工", "status": "有效", "parent_id": "r018", "related_ids": [], "heading_path": ["办公网络接入指南", "第十八节 故障处理问答"], "token_count": 233, "kind": "text", "table_id": null, "row_id": null, "quality_warnings": [], "source_locations": [{"file_id": "D05-canonical", "source_path": "data/source_materials/corpus/pdf_native/D05_办公网络接入指南_原生.pdf", "sha256": "468dcdffde9e628d40f6b7a32db4b483af08f657c4a450b05524e31b616e15cf", "method": "pdf_text", "page": 5, "bbox": [48.0, 323.1171875, 168.75, 334.6171875], "line_start": null, "line_end": null, "confidence": null}, {"file_id": "D05-canonical", "source_path": "data/source_materials/corpus/pdf_native/D05_办公网络接入指南_原生.pdf", "sha256": "468dcdffde9e628d40f6b7a32db4b483af08f657c4a450b05524e31b616e15cf", "method": "pdf_text", "page": 5, "bbox": [48.0, 349.9765625, 541.5, 377.9765625], "line_start": null, "line_end": null, "confidence": null}, {"file_id": "D05-canonical", "source_path": "data/source_materials/corpus/pdf_native/D05_办公网络接入指南_原生.pdf", "sha256": "468dcdffde9e628d40f6b7a32db4b483af08f657c4a450b05524e31b616e15cf", "method": "pdf_text", "page": 5, "bbox": [48.0, 393.9765625, 541.5, 439.4765625], "line_start": null, "line_end": null, "confidence": null}], "snippet": "第十八节 故障处理问答\n\n问：验证码错误时先做什么？答：检查当前验证码有效性、输入内容及设备时间，仍失败联系服务台。问：可以把验证码和密码一起发给服务台吗？答：不要提供这些凭据，可以提供错误提示和发生时间。\n\n问：换了网络后仍失败怎么办？答：记录网络、时间、错误提示和已排查步骤，联系服务台。问：连接失败能否关闭安全软件试试？答：本文没有授权此类操作，不应自行", "rrf_score": 0.016393, "bm25_score": 9.8163, "vector_score": 0.411016}, {"doc_id": "D05", "version_date": "2026-01-01", "chunk_id": "c011", "title": "办公网络接入指南", "topic": "VPN", "scope": "全体员工", "status": "有效", "parent_id": "r011", "related_ids": [], "heading_path": ["办公网络接入指南", "第十一节 允许提供的排查材料"], "token_count": 227, "kind": "text", "table_id": null, "row_id": null, "quality_warnings": [], "source_locations": [{"file_id": "D05-canonical", "source_path": "data/source_materials/corpus/pdf_native/D05_办公网络接入指南_原生.pdf", "sha256": "468dcdffde9e628d40f6b7a32db4b483af08f657c4a450b05524e31b616e15cf", "method": "pdf_text", "page": 3, "bbox": [48.0, 461.6171875, 203.25, 473.1171875], "line_start": null, "line_end": null, "confidence": null}, {"file_id": "D05-canonical", "source_path": "data/source_materials/corpus/pdf_native/D05_办公网络接入指南_原生.pdf", "sha256": "468dcdffde9e628d40f6b7a32db4b483af08f657c4a450b05524e31b616e15cf", "method": "pdf_text", "page": 3, "bbox": [48.0, 488.4765625, 541.5, 516.4765625], "line_start": null, "line_end": null, "confidence": null}, {"file_id": "D05-canonical", "source_path": "data/source_materials/corpus/pdf_native/D05_办公网络接入指南_原生.pdf", "sha256": "468dcdffde9e628d40f6b7a32db4b483af08f657c4a450b05524e31b616e15cf", "method": "pdf_text", "page": 3, "bbox": [48.0, 532.4765625, 541.5, 560.4765625], "line_start": null, "line_end": null, "confidence": null}], "snippet": "第十一节 允许提供的排查材料\n\n工单可以包含企业账号标识、客户端显示的错误文字、发生时间、网络类型、目标系统名称以及已经尝试的排查步骤。截图应遮盖无关个人信息、其他系统业务数据和登录凭据，保留与错误相关的区域。\n\n不要提供密码、动态验证码、恢复码或完整的业务数据库内容。日志应通过企业确认的渠道提交，本文未授权把内部日志上传到公开网盘或论坛。需要更详细日志时，", "rrf_score": 0.015873, "bm25_score": 1.472182, "vector_score": 0.495136}]}}
