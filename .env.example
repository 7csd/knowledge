# API root INCLUDING /v1 when required by your provider. Do not include /chat/completions.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=45
# hybrid requires: pip install -e ".[semantic]" and an available embedding model.
# bm25 is an explicit lexical-only mode, not semantic retrieval.
RETRIEVAL_MODE=hybrid
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_REVISION=7999e1d3359715c523056ef9478215996d62a620
EMBEDDING_LOCAL_ONLY=false
VECTOR_MIN_SCORE=0.45
MAX_MODEL_STEPS=8
MAX_TOOL_CALLS=12
TOOL_TIMEOUT_SECONDS=15
DATA_PATH=data/processed-incremental-verified/corpus.json
CACHE_DIR=.cache
VECTOR_BACKEND=qdrant
VECTOR_DB_PATH=.cache/qdrant
